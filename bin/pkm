#!/usr/bin/env bash

set -e

# Thay USERNAME/pkm bằng tên GitHub repo của bạn
REPO_URL="https://github.com/USERNAME/pkm.git"
INSTALL_DIR="$HOME/.pkm"

echo "🚀 Đang tiến hành cài đặt PKM (Personal Package Manager)..."

# 1. Clone repository về ~/.pkm
if [ -d "$INSTALL_DIR" ]; then
    echo "🔄 Đã tìm thấy ~/.pkm, đang cập nhật..."
    git -C "$INSTALL_DIR" pull --quiet
else
    echo "📥 Đang tải PKM từ GitHub..."
    git clone --quiet "$REPO_URL" "$INSTALL_DIR"
fi

# 2. Tạo các thư mục làm việc cần thiết
mkdir -p "$INSTALL_DIR/packages"
mkdir -p "$INSTALL_DIR/bin"

# 3. Cấp quyền thi hành
chmod +x "$INSTALL_DIR/bin/pkm"

# 4. Tự động thêm PATH vào Shell Config (.zshrc hoặc .bashrc)
SHELL_CONFIG=""
if [ -n "$ZSH_VERSION" ] || [ -f "$HOME/.zshrc" ]; then
    SHELL_CONFIG="$HOME/.zshrc"
elif [ -f "$HOME/.bashrc" ]; then
    SHELL_CONFIG="$HOME/.bashrc"
fi

PATH_CMD='export PATH="$HOME/.pkm/bin:$PATH"'

if [ -n "$SHELL_CONFIG" ]; then
    if ! grep -q '\.pkm/bin' "$SHELL_CONFIG"; then
        echo "" >> "$SHELL_CONFIG"
        echo "# PKM Package Manager" >> "$SHELL_CONFIG"
        echo "$PATH_CMD" >> "$SHELL_CONFIG"
        echo "✅ Đã thêm $HOME/.pkm/bin vào $SHELL_CONFIG"
    fi
fi

echo ""
echo "🎉 Cài đặt hoàn tất!"
echo "👉 Hãy chạy lệnh sau để áp dụng ngay:"
echo "   source $SHELL_CONFIG"
echo ""
echo "💡 Thử nghiệm với lệnh: pkm install fnm"

PKM_DIR="$HOME/.pkm"
RECIPES_DIR="$PKM_DIR/recipes"
PACKAGES_DIR="$PKM_DIR/packages"
BIN_DIR="$PKM_DIR/bin"

# 1. Hàm cài đặt theo tên công cụ truyền vào
install_package() {
    PKG_NAME=$1

    # Kiểm tra người dùng có nhập tên công cụ không
    if [ -z "$PKG_NAME" ]; then
        echo "❌ Lỗi: Bạn chưa nhập tên công cụ! Cú pháp: pkm install <tên_công_cụ>"
        exit 1
    fi

    # Đường dẫn tới file recipe
    RECIPE="$RECIPES_DIR/$PKG_NAME.sh"

    # Kiểm tra xem có recipe tương ứng trong thư mục recipes/ không
    if [ ! -f "$RECIPE" ]; then
        echo "❌ Lỗi: Không tìm thấy công thức cài đặt cho '$PKG_NAME'"
        echo "💡 Gợi ý: Kiểm tra file recipes/$PKG_NAME.sh đã tồn tại chưa."
        exit 1
    fi

    # Đọc các biến khai báo trong file recipe
    source "$RECIPE"

    INSTALL_DIR="$PACKAGES_DIR/$NAME/$VERSION"
    TEMP_FILE="/tmp/${NAME}_download"

    echo "📦 Đang tải $NAME (Phiên bản $VERSION)..."
    mkdir -p "$INSTALL_DIR"
    curl -L -o "$TEMP_FILE" "$URL"

    echo "📂 Đang xử lý file..."
    if [ "$TYPE" == "zip" ]; then
        unzip -o -q "$TEMP_FILE" -d "$INSTALL_DIR"
    elif [ "$TYPE" == "tar.gz" ]; then
        tar -xzf "$TEMP_FILE" -C "$INSTALL_DIR"
    elif [ "$TYPE" == "binary" ]; then
        # Nếu là file chạy trực tiếp, chuyển thẳng vào thư mục cài đặt
        mv "$TEMP_FILE" "$INSTALL_DIR/$BINARY_NAME"
    fi

    # Xóa file tạm nếu chưa xóa
    rm -f "$TEMP_FILE"

    echo "🔗 Đang tạo liên kết thực thi (Symlink)..."
    chmod +x "$INSTALL_DIR/$BINARY_NAME"
    ln -sf "$INSTALL_DIR/$BINARY_NAME" "$BIN_DIR/$BINARY_NAME"

    echo "✅ Cài đặt thành công $NAME! Bạn có thể dùng lệnh '$BINARY_NAME' ngay bây giờ."
}

# 2. Hàm gỡ bỏ công cụ
remove_package() {
    PKG_NAME=$1
    if [ -z "$PKG_NAME" ]; then
        echo "❌ Lỗi: Cú pháp gỡ bỏ: pkm remove <tên_công_cụ>"
        exit 1
    fi

    RECIPE="$RECIPES_DIR/$PKG_NAME.sh"
    if [ -f "$RECIPE" ]; then
        source "$RECIPE"
        echo "🗑️  Đang gỡ bỏ $NAME..."
        rm -rf "$PACKAGES_DIR/$NAME"
        rm -f "$BIN_DIR/$BINARY_NAME"
        echo "✅ Đã gỡ bỏ $NAME!"
    else
        echo "❌ Không tìm thấy thông tin gói $PKG_NAME"
    fi
}

# 3. Liệt kê các công cụ đã cài
list_packages() {
    echo "📋 Các công cụ đã cài đặt qua PKM:"
    ls -1 "$PACKAGES_DIR" 2>/dev/null || echo "(Chưa cài công cụ nào)"
}

# Điều hướng tham số
case "$1" in
    install)
        install_package "$2"
        ;;
    remove)
        remove_package "$2"
        ;;
    list)
        list_packages
        ;;
    *)
        echo "Cú pháp sử dụng:"
        echo "  pkm install <tên_công_cụ>  - Cài đặt công cụ"
        echo "  pkm remove <tên_công_cụ>   - Gỡ bỏ công cụ"
        echo "  pkm list                  - Xem danh sách đã cài"
        ;;
esac
