#!/usr/bin/env bash

PKM_DIR="$HOME/.pkm"
RECIPES_DIR="$PKM_DIR/recipes"
PACKAGES_DIR="$PKM_DIR/packages"
BIN_DIR="$PKM_DIR/bin"

# 1. Cài đặt công cụ
install_package() {
    PKG_NAME=$1

    if [ -z "$PKG_NAME" ]; then
        echo "❌ Lỗi: Cú pháp: pkm install <tên_công_cụ>"
        exit 1
    fi

    RECIPE="$RECIPES_DIR/$PKG_NAME.sh"

    if [ ! -f "$RECIPE" ]; then
        echo "❌ Lỗi: Không tìm thấy công thức cài đặt cho '$PKG_NAME'"
        exit 1
    fi

    source "$RECIPE"

    INSTALL_DIR="$PACKAGES_DIR/$NAME/$VERSION"
    TEMP_FILE="/tmp/${NAME}_download"

    echo "📦 Đang tải $NAME ($VERSION)..."
    mkdir -p "$INSTALL_DIR"
    curl -L -o "$TEMP_FILE" "$URL"

    echo "📂 Đang xử lý file..."
    if [ "$TYPE" == "zip" ]; then
        unzip -o -q "$TEMP_FILE" -d "$INSTALL_DIR"
    elif [ "$TYPE" == "tar.gz" ]; then
        tar -xzf "$TEMP_FILE" -C "$INSTALL_DIR"
    elif [ "$TYPE" == "binary" ]; then
        mv "$TEMP_FILE" "$INSTALL_DIR/$BINARY_NAME"
    fi

    rm -f "$TEMP_FILE"

    echo "🔗 Đang tạo Symlink..."
    chmod +x "$INSTALL_DIR/$BINARY_NAME"
    ln -sf "$INSTALL_DIR/$BINARY_NAME" "$BIN_DIR/$BINARY_NAME"

    echo "✅ Cài đặt thành công $NAME ($VERSION)!"
}

# 2. Chuyển đổi phiên bản (Switch Version)
switch_version() {
    PKG_NAME=$1
    TARGET_VER=$2

    if [ -z "$PKG_NAME" ] || [ -z "$TARGET_VER" ]; then
        echo "❌ Lỗi: Cú pháp: pkm switch <tên_công_cụ> <phiên_bản>"
        echo "💡 Ví dụ: pkm switch node 18.20.0"
        exit 1
    fi

    # Tìm file recipe để lấy BINARY_NAME chính xác
    RECIPE="$RECIPES_DIR/$PKG_NAME.sh"
    if [ -f "$RECIPE" ]; then
        source "$RECIPE"
    else
        BINARY_NAME="$PKG_NAME"
    fi

    TARGET_BIN="$PACKAGES_DIR/$PKG_NAME/$TARGET_VER/$BINARY_NAME"

    if [ -f "$TARGET_BIN" ]; then
        ln -sf "$TARGET_BIN" "$BIN_DIR/$BINARY_NAME"
        echo "🔄 Đã chuyển $PKG_NAME sang sử dụng phiên bản $TARGET_VER!"
    else
        echo "❌ Lỗi: Phiên bản $TARGET_VER của $PKG_NAME chưa được cài đặt tại $PACKAGES_DIR/$PKG_NAME/"
        echo "💡 Gợi ý: Kiểm tra danh sách phiên bản đã tải bằng: ls $PACKAGES_DIR/$PKG_NAME"
    fi
}

# 3. Gỡ bỏ công cụ
remove_package() {
    PKG_NAME=$1
    if [ -z "$PKG_NAME" ]; then
        echo "❌ Lỗi: Cú pháp: pkm remove <tên_công_cụ>"
        exit 1
    fi

    RECIPE="$RECIPES_DIR/$PKG_NAME.sh"
    if [ -f "$RECIPE" ]; then
        source "$RECIPE"
        echo "🗑️  Đang gỡ bỏ $NAME..."
        rm -rf "$PACKAGES_DIR/$NAME"
        rm -f "$BIN_DIR/$BINARY_NAME"
        echo "✅ Đã gỡ bỏ $NAME!"
    else
        echo "❌ Không tìm thấy thông tin gói $PKG_NAME"
    fi
}

# 4. Liệt kê các công cụ đã cài
list_packages() {
    echo "📋 Các công cụ đã cài đặt qua PKM:"
    if [ -d "$PACKAGES_DIR" ] && [ "$(ls -A "$PACKAGES_DIR")" ]; then
        for pkg in "$PACKAGES_DIR"/*; do
            if [ -d "$pkg" ]; then
                pkg_name=$(basename "$pkg")
                versions=$(ls -1 "$pkg" | tr '\n' ' ')
                echo "  • $pkg_name (Phiên bản khả dụng: $versions)"
            fi
        done
    else
        echo "  (Chưa cài công cụ nào)"
    fi
}

# 5. Cập nhật recipe từ Git Remote
update_pkm() {
    echo "🔄 Đang cập nhật recipes từ GitHub..."
    if [ -d "$PKM_DIR/.git" ]; then
        git -C "$PKM_DIR" pull --quiet
        echo "✅ Cập nhật hoàn tất!"
    else
        echo "❌ $PKM_DIR không phải là một Git repository!"
    fi
}

# Điều hướng lệnh
case "$1" in
    install)  install_package "$2" ;;
    switch)   switch_version "$2" "$3" ;;
    remove)   remove_package "$2" ;;
    list)     list_packages ;;
    update)   update_pkm ;;
    *)
        echo "Cú pháp sử dụng PKM:"
        echo "  pkm install <tên_gói>        - Cài đặt gói"
        echo "  pkm switch <tên_gói> <ver>   - Nhanh chóng đổi phiên bản"
        echo "  pkm remove <tên_gói>         - Gỡ bỏ gói"
        echo "  pkm list                    - Xem danh sách và các phiên bản đã cài"
        echo "  pkm update                  - Cập nhật recipes từ GitHub"
        ;;
esac
