#!/usr/bin/env bash

# Bash Strict Mode for better error handling
set -eo pipefail

# ==========================================
# DIRECTORY CONFIGURATION
# ==========================================
PKM_DIR="$HOME/.pkm"
RECIPES_DIR="$PKM_DIR/recipes"
PACKAGES_DIR="$PKM_DIR/packages"
BIN_DIR="$PKM_DIR/bin"

# Create directories if they do not exist
mkdir -p "$RECIPES_DIR" "$PACKAGES_DIR" "$BIN_DIR"

# ==========================================
# COLORS & UI
# ==========================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No color

log_info() { echo -e "${BLUE}ℹ️ $1${NC}"; }
log_success() { echo -e "${GREEN}✅ $1${NC}"; }
log_warn() { echo -e "${YELLOW}⚠️ $1${NC}"; }
log_error() { echo -e "${RED}❌ $1${NC}"; }

# ==========================================
# CLEANUP & SYSTEM CHECKS
# ==========================================
TEMP_FILE=""

cleanup() {
    if [ -n "$TEMP_FILE" ] && [ -f "$TEMP_FILE" ]; then
        rm -f "$TEMP_FILE"
    fi
}
trap cleanup EXIT

check_path() {
    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then
        log_warn "Directory $BIN_DIR is not in your \$PATH."
        log_warn "Please add the following line to your ~/.bashrc or ~/.zshrc:"
        echo "export PATH=\"$BIN_DIR:\$PATH\""
    fi
}

# ==========================================
# MAIN FEATURES
# ==========================================

# 1. Install package
install_package() {
    local PKG_NAME=$1

    if [ -z "$PKG_NAME" ]; then
        log_error "Usage: pkm install <package_name>"
        exit 1
    fi

    local RECIPE="$RECIPES_DIR/$PKG_NAME.sh"

    if [ ! -f "$RECIPE" ]; then
        log_error "Recipe file not found: $RECIPE"
        exit 1
    fi

    # Initialize empty variables to avoid unbound variable errors
    NAME="" VERSION="" URL="" TYPE="" BINARY_NAME=""
    
    # Source the recipe
    source "$RECIPE"

    # Check recipe integrity
    if [ -z "$NAME" ] || [ -z "$VERSION" ] || [ -z "$URL" ] || [ -z "$BINARY_NAME" ]; then
        log_error "Recipe '$PKG_NAME.sh' is missing required fields (NAME, VERSION, URL, BINARY_NAME)."
        exit 1
    fi

    local INSTALL_DIR="$PACKAGES_DIR/$NAME/$VERSION"
    TEMP_FILE=$(mktemp /tmp/pkm_${NAME}_XXXXXX)

    log_info "Downloading $NAME version $VERSION..."
    mkdir -p "$INSTALL_DIR"
    
    if ! curl -fsSL -o "$TEMP_FILE" "$URL"; then
        log_error "Failed to download from URL: $URL"
        rm -rf "$INSTALL_DIR" # Remove empty directory on download failure
        exit 1
    fi

    log_info "Extracting files..."
    case "$TYPE" in
        zip)
            unzip -o -q "$TEMP_FILE" -d "$INSTALL_DIR"
            ;;
        tar.gz|tgz)
            tar -xzf "$TEMP_FILE" -C "$INSTALL_DIR"
            ;;
        binary)
            mv "$TEMP_FILE" "$INSTALL_DIR/$BINARY_NAME"
            ;;
        *)
            log_error "Unsupported archive type: '$TYPE'"
            rm -rf "$INSTALL_DIR"
            exit 1
            ;;
    esac

    local TARGET_BIN
    TARGET_BIN=$(find "$INSTALL_DIR" -type f -name "$BINARY_NAME" | head -n 1)

    if [ -z "$TARGET_BIN" ]; then
        log_error "Binary '$BINARY_NAME' not found in extracted files."
        exit 1
    fi

    log_info "Creating symlink..."
    chmod +x "$TARGET_BIN"
    ln -sf "$TARGET_BIN" "$BIN_DIR/$BINARY_NAME"

    log_success "Successfully installed $NAME ($VERSION)!"
    check_path
}

# 2. Switch version
switch_version() {
    local PKG_NAME=$1
    local TARGET_VER=$2

    if [ -z "$PKG_NAME" ] || [ -z "$TARGET_VER" ]; then
        log_error "Usage: pkm switch <package_name> <version>"
        exit 1
    fi

    local TARGET_DIR="$PACKAGES_DIR/$PKG_NAME/$TARGET_VER"

    if [ ! -d "$TARGET_DIR" ]; then
        log_error "Version '$TARGET_VER' of '$PKG_NAME' is not installed."
        exit 1
    fi

    local RECIPE="$RECIPES_DIR/$PKG_NAME.sh"
    local BINARY_NAME=""
    
    [ -f "$RECIPE" ] && source "$RECIPE"
    [ -z "$BINARY_NAME" ] && BINARY_NAME="$PKG_NAME"

    local TARGET_BIN
    TARGET_BIN=$(find "$TARGET_DIR" -type f -name "$BINARY_NAME" | head -n 1)

    if [ -z "$TARGET_BIN" ]; then
        log_error "Executable binary '$BINARY_NAME' not found in $TARGET_DIR."
        exit 1
    fi

    ln -sf "$TARGET_BIN" "$BIN_DIR/$BINARY_NAME"
    log_success "Successfully switched $PKG_NAME to version $TARGET_VER!"
}

# 3. List installed packages
list_packages() {
    log_info "Installed packages:"
    if [ ! -d "$PACKAGES_DIR" ] || [ -z "$(ls -A "$PACKAGES_DIR")" ]; then
        echo " (No packages installed yet)"
        return
    fi

    for pkg in "$PACKAGES_DIR"/*; do
        if [ -d "$pkg" ]; then
            local pkg_name=$(basename "$pkg")
            echo -e "📦 ${GREEN}$pkg_name${NC}:"
            for ver in "$pkg"/*; do
                if [ -d "$ver" ]; then
                    local ver_name=$(basename "$ver")
                    echo "   - $ver_name"
                fi
            done
        fi
    done
}

# ==========================================
# CLI ROUTING (MAIN)
# ==========================================
show_help() {
    echo -e "${YELLOW}PKM (Personal Package Manager)${NC}"
    echo "Usage:"
    echo "  pkm install <pkg_name>       Install a package from recipe"
    echo "  pkm switch <pkg_name> <ver>  Switch package version"
    echo "  pkm list                     List all installed packages"
    echo "  pkm help                     Show this help menu"
}

COMMAND=${1:-"help"}

case "$COMMAND" in
    install)
        install_package "$2"
        ;;
    switch)
        switch_version "$2" "$3"
        ;;
    list)
        list_packages
        ;;
    help)
        show_help
        ;;
    *)
        log_error "Invalid command: '$COMMAND'."
        show_help
        exit 1
        ;;
esac
