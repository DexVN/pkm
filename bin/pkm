#!/usr/bin/env bash

PKM_DIR="$HOME/.pkm"
RECIPES_DIR="$PKM_DIR/recipes"
PACKAGES_DIR="$PKM_DIR/packages"
BIN_DIR="$PKM_DIR/bin"

# 1. Install package
install_package() {
    PKG_NAME=$1

    if [ -z "$PKG_NAME" ]; then
        echo "❌ Error: Usage: pkm install <package_name>"
        exit 1
    fi

    RECIPE="$RECIPES_DIR/$PKG_NAME.sh"

    if [ ! -f "$RECIPE" ]; then
        echo "❌ Error: Recipe for '$PKG_NAME' not found."
        exit 1
    fi

    source "$RECIPE"

    INSTALL_DIR="$PACKAGES_DIR/$NAME/$VERSION"
    TEMP_FILE="/tmp/${NAME}_download"

    echo "📦 Downloading $NAME ($VERSION)..."
    mkdir -p "$INSTALL_DIR"
    curl -L -o "$TEMP_FILE" "$URL"

    echo "📂 Extracting files..."
    if [ "$TYPE" == "zip" ]; then
        unzip -o -q "$TEMP_FILE" -d "$INSTALL_DIR"
    elif [ "$TYPE" == "tar.gz" ] || [ "$TYPE" == "tgz" ]; then
        tar -xzf "$TEMP_FILE" -C "$INSTALL_DIR"
    elif [ "$TYPE" == "binary" ]; then
        mv "$TEMP_FILE" "$INSTALL_DIR/$BINARY_NAME"
    fi

    rm -f "$TEMP_FILE"

    TARGET_BIN=$(find "$INSTALL_DIR" -type f -name "$BINARY_NAME" | head -n 1)

    if [ -z "$TARGET_BIN" ]; then
        echo "❌ Error: Binary '$BINARY_NAME' not found in extracted files."
        exit 1
    fi

    echo "🔗 Creating symlink..."
    chmod +x "$TARGET_BIN"
    mkdir -p "$BIN_DIR"
    ln -sf "$TARGET_BIN" "$BIN_DIR/$BINARY_NAME"

    echo "✅ Successfully installed $NAME ($VERSION)!"
}

# 2. Switch version
switch_version() {
    PKG_NAME=$1
    TARGET_VER=$2

    if [ -z "$PKG_NAME" ] || [ -z "$TARGET_VER" ]; then
        echo "❌ Error: Usage: pkm switch <package_name> <version>"
        echo "💡 Example: pkm switch node 18.20.0"
        exit 1
    fi

    # Find recipe file to retrieve correct BINARY_NAME
    RECIPE="$RECIPES_DIR/$PKG_NAME.sh"
    if [ -f "$RECIPE" ]; then
        source "$RECIPE"
    else
        BINARY_NAME="$PKG_NAME"
    fi

    TARGET_BIN="$PACKAGES_DIR/$PKG_NAME/$TARGET_VER/$BINARY_NAME"

    if [ -f "$TARGET_BIN" ]; then
        ln -sf "$TARGET_BIN" "$BIN_DIR/$BINARY_NAME"
        echo "🔄 Switched $PKG_NAME to version $TARGET_VER!"
    else
        echo "❌ Error: Version $TARGET_VER of $PKG_NAME is not installed at $PACKAGES_DIR/$PKG_NAME/"
        echo "💡 Hint: Check installed versions using: ls $PACKAGES_DIR/$PKG_NAME"
    fi
}

# 3. Remove package
remove_package() {
    PKG_NAME=$1
    if [ -z "$PKG_NAME" ]; then
        echo "❌ Error: Usage: pkm remove <package_name>"
        exit 1
    fi

    RECIPE="$RECIPES_DIR/$PKG_NAME.sh"
    if [ -f "$RECIPE" ]; then
        source "$RECIPE"
        echo "🗑️  Removing $NAME..."
        rm -rf "$PACKAGES_DIR/$NAME"
        rm -f "$BIN_DIR/$BINARY_NAME"
        echo "✅ Successfully removed $NAME!"
    else
        echo "❌ Error: Package info for '$PKG_NAME' not found."
    fi
}

# 4. List installed packages
list_packages() {
    echo "📋 Installed packages via PKM:"
    if [ -d "$PACKAGES_DIR" ] && [ "$(ls -A "$PACKAGES_DIR")" ]; then
        for pkg in "$PACKAGES_DIR"/*; do
            if [ -d "$pkg" ]; then
                pkg_name=$(basename "$pkg")
                versions=$(ls -1 "$pkg" | tr '\n' ' ')
                echo "  • $pkg_name (Available versions: $versions)"
            fi
        done
    else
        echo "  (No packages installed)"
    fi
}

# 5. Update recipes from Git Remote
update_pkm() {
    echo "🔄 Updating recipes from GitHub..."
    if [ -d "$PKM_DIR/.git" ]; then
        git -C "$PKM_DIR" pull --quiet
        echo "✅ Update complete!"
    else
        echo "❌ Error: $PKM_DIR is not a Git repository!"
    fi
}

# Command routing
case "$1" in
    install)  install_package "$2" ;;
    switch)   switch_version "$2" "$3" ;;
    remove)   remove_package "$2" ;;
    list)     list_packages ;;
    update)   update_pkm ;;
    *)
        echo "PKM Usage:"
        echo "  pkm install <pkg>         - Install a package"
        echo "  pkm switch <pkg> <ver>    - Switch to installed version"
        echo "  pkm remove <pkg>          - Remove a package"
        echo "  pkm list                  - List installed packages and versions"
        echo "  pkm update                - Update recipes from GitHub"
        ;;
esac
